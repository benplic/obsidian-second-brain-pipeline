# Copy to .env (gitignored) and fill in. Get a key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY is also accepted.
# Extra Gemini keys are optional and incremental: GEMINI_API_KEY_2, GEMINI_API_KEY_3, ...
# The crusher uses the next one when the current key's daily quota is exhausted.
GEMINI_API_KEY=
# GEMINI_API_KEY_2=

# Optional: point at a config file other than ./config.yaml
# SECOND_BRAIN_CONFIG=
